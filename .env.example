# Neon pooled or unpooled Postgres connection string
DATABASE_URL=

# Paystack keys: use test keys during development
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Long random secret used to sign admin sessions (minimum 32 bytes)
ADMIN_SESSION_SECRET=

# Canonical deployed origin, e.g. https://care500.vercel.app
APP_URL=

# First admin account; used only by npm run db:seed
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: set to test to disable production-only cookie flags locally
NODE_ENV=development
